{
  "name": "cloudshelf",
  "version": "0.1.0",
  "description": "A self-hosted, Chinese-friendly cloud reader for EPUB and TXT books.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node --experimental-sqlite src/server.js",
    "dev": "node --experimental-sqlite --watch src/server.js",
    "smoke": "node scripts/smoke.js",
    "reset-admin-password": "node --experimental-sqlite scripts/reset-admin-password.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "bcryptjs": "^3.0.2",
    "busboy": "^1.6.0",
    "cookie": "^1.0.2",
    "fast-xml-parser": "^5.2.5",
    "html-to-text": "^9.0.5",
    "iconv-lite": "^0.6.3",
    "mime-types": "^2.1.35",
    "saxes": "^6.0.0"
  }
}
